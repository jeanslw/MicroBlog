# ============================================================
# docker-compose 变量模板
# 使用方法：
#   cp .env.docker.example .env.docker
#   只需填写下方 MySQL 账号密码，其余保持默认即可启动
#   docker compose --env-file .env.docker --profile full up -d
#
# 注意：本文件仅作模板，请勿填入真实密码后提交到 git
# ============================================================

# ── Flask 应用（可选）──────────────────────────────────────
# Session/CSRF 密钥。留空时 compose 使用内置的测试默认密钥（公开、不安全），
# 仅适合本机测试；公网部署必须取消注释并设置为随机值，生成命令：
#   python -c "import secrets;print(secrets.token_hex(32))"
#BLOG_SECRET_KEY=

# 站点固定外链域名（防 Host 头注入，生产强烈建议配置）
# 示例：https://blog.example.com
BLOG_CANONICAL_URL=
# Host 白名单（逗号分隔），非白名单 Host 请求返回 400
# 留空不校验；生产建议设置为真实域名，如 blog.example.com
BLOG_TRUSTED_HOSTS=
# 内置 nginx 默认仅提供明文 HTTP(80)，故 compose 默认 false，保证 HTTP 登录正常；
# 按 nginx/nginx.conf 顶部步骤取消注释启用 HTTPS(443) 后置为 true，
# 公网环境不要在明文 HTTP 下关闭
BLOG_COOKIE_SECURE=false

# ── 反代头解析（compose 已内置正确默认值，一般无需修改）──────
# XFOR/XPROTO：信任一层 nginx 的 X-Forwarded-For / X-Forwarded-Proto
# （取真实访客 IP 用于登录锁定/限流；HTTPS 下正确识别协议）
# XHOST 保持 0：nginx 已直接转发 Host 头，不信任可伪造的 X-Forwarded-Host
#BLOG_PROXY_XFOR=1
#BLOG_PROXY_XPROTO=1
#BLOG_PROXY_XHOST=0

# ── 数据库类型：sqlite 或 mysql ───────────────────────────
# mysql：docker compose --env-file .env.docker --profile mysql up -d（web + db）
#        完整带 nginx：--profile full
# sqlite：docker compose up -d web（仅 web，无需任何密码）
# 注意：BLOG_DB_TYPE=mysql 但 MySQL 连接字段缺失时应用拒绝启动（不静默回退）
BLOG_DB_TYPE=mysql

# ── MySQL 必填（BLOG_DB_TYPE=mysql 时）────────────────────
# ★ 复制本文件后只需修改下面两个密码即可开箱启动
MYSQL_ROOT_PASSWORD=请替换为强密码
MYSQL_DATABASE=flask_blog
MYSQL_USER=blog
MYSQL_PASSWORD=请替换为强密码

# ── 业务参数（可选）──────────────────────────────────────
BLOG_PAGE_SIZE=6
BLOG_STATIC_MAX_AGE=43200
# 密码找回令牌有效期（秒，默认 1800）
BLOG_RESET_TOKEN_MAX_AGE=1800

# ── SMTP 邮件（可选，找回密码/测试邮件用）────────────────
# 不配置时可在 管理后台 → 邮件设置 中填写（后台配置优先于本文件）
# 示例（QQ 邮箱）：
#   BLOG_MAIL_HOST=smtp.qq.com
#   BLOG_MAIL_PORT=465
#   BLOG_MAIL_USER=xxx@qq.com
#   BLOG_MAIL_PASSWORD=授权码
#   BLOG_MAIL_FROM=xxx@qq.com
#   BLOG_MAIL_USE_SSL=true
#   BLOG_MAIL_USE_TLS=false
BLOG_MAIL_HOST=
BLOG_MAIL_PORT=587
BLOG_MAIL_USER=
BLOG_MAIL_PASSWORD=
BLOG_MAIL_FROM=
BLOG_MAIL_USE_SSL=false
BLOG_MAIL_USE_TLS=true

# ── 初始管理员（可选）─────────────────────────────────────
# 留空：不自动建号，启动后首访 /admin/setup 通过引导页创建管理员
# 填密码：首次初始化时自动创建（仅 admin 表为空时生效一次，不会覆盖已有账号）
BLOG_INIT_ADMIN_USER=admin
BLOG_INIT_ADMIN_PWD=

# ── 调试用 ────────────────────────────────────────────────
# 直连 web 服务的宿主机端口（默认 127.0.0.1:5000，冲突时修改）
#WEB_PORT=5000
