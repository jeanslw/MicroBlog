# 博客系统环境变量示例。使用方法：复制本文件为 app.env，填入实际值
#   cp app.env.example app.env   （Windows: Copy-Item app.env.example app.env）
# app.env 已在 .gitignore 中忽略，不会入库
# 本文件为应用侧配置（裸机 / 本地运行，由 python-dotenv 加载）；
# Docker 部署改用编排侧的 .env.docker（模板 .env.docker.example），两者互不影响

# 必填（生产环境）：设为 production 后 BLOG_SECRET_KEY 必须显式提供
BLOG_ENV=production

# Session / CSRF 密钥，须使用随机长字符串
# 生成命令：python -c "import secrets;print(secrets.token_hex(32))"
BLOG_SECRET_KEY=

# 站点固定外链域名（防 Host 头注入），用于邮件重置链接、RSS/Atom、sitemap
# 示例：https://blog.example.com；留空则回退到请求 Host，仅开发用
BLOG_CANONICAL_URL=
# Host 白名单（逗号分隔），非白名单 Host 的请求返回 400，留空表示不校验
# 示例：blog.example.com,www.blog.example.com
BLOG_TRUSTED_HOSTS=

# 调试
# 生产环境保持 False，避免 Werkzeug 调试器暴露导致 RCE
BLOG_DEBUG=False
# 生产环境默认 true；仅本地明文 HTTP 调试时设为 false
#BLOG_COOKIE_SECURE=false

# 数据库
# 数据库类型：sqlite 或 mysql
BLOG_DB_TYPE=sqlite

# MySQL 配置（BLOG_DB_TYPE=mysql 时生效）
# 若 HOST/USER/DB 等关键字段缺失，应用拒绝启动而不回退到 SQLite
BLOG_MYSQL_HOST=localhost
BLOG_MYSQL_USER=root
BLOG_MYSQL_PWD=
BLOG_MYSQL_DB=flask_blog

# SQLite 配置（BLOG_DB_TYPE=sqlite 时生效）
BLOG_SQLITE_PATH=data/blog.db

# 数据库结构迁移：true 启动时自动执行待迁移项；false 站点进入 503 维护状态，由后台手动执行
#BLOG_AUTO_MIGRATE=true

# 降级守卫：数据库版本高于程序版本时拒绝启动；true 放行仅告警
#BLOG_ALLOW_SCHEMA_AHEAD=false

# 业务参数
BLOG_PAGE_SIZE=6
# 静态文件缓存秒数（生产建议 43200）
BLOG_STATIC_MAX_AGE=0
# Session 有效期（秒，默认 86400 = 24 小时）
BLOG_SESSION_LIFETIME=86400

# 日志（应用日志同时写控制台和文件，默认 项目根/logs/app.log）
#BLOG_LOG_DIR=logs
# 单文件大小上限（字节，默认 10485760 = 10MB）与保留份数
#BLOG_LOG_MAX_BYTES=10485760
#BLOG_LOG_BACKUP_COUNT=5
# 日志格式：auto（生产单行 JSON / 开发测试文本）、json、text
#BLOG_LOG_FORMAT=auto
# 慢请求阈值（毫秒，默认 500）：超阈值请求日志升级为 WARNING
#BLOG_SLOW_REQUEST_MS=500
# 慢 SQL 阈值（毫秒，默认 200）：超阈值语句记 slow_query WARNING
#BLOG_SLOW_QUERY_MS=200

# 反向代理：信任的层数，用于获取真实客户端 IP / 协议 / Host
#BLOG_PROXY_XFOR=1
#BLOG_PROXY_XPROTO=1
#BLOG_PROXY_XHOST=1

# 邮件（找回密码 / 通知，可选）；后台「邮件设置」保存后优先于此处生效
#BLOG_MAIL_HOST=smtp.example.com
#BLOG_MAIL_PORT=587
#BLOG_MAIL_USER=your_account@example.com
#BLOG_MAIL_PASSWORD=
#BLOG_MAIL_FROM=your_account@example.com
#BLOG_MAIL_USE_SSL=False
#BLOG_MAIL_USE_TLS=True
# 密码找回令牌有效期（秒，默认 1800 = 30 分钟）
#BLOG_RESET_TOKEN_MAX_AGE=1800

# 初始管理员（仅 SQLite 首次建表写入一次，MySQL 请手动 INSERT）
BLOG_INIT_ADMIN_USER=admin
# 首次启动需要设置；建表后修改密码请走「后台 → 改密码」
BLOG_INIT_ADMIN_PWD=
