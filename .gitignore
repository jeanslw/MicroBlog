# 默认忽略的文件

/.venv/*
/.idea/*
/.vscode/*
/__pycache__/*
/app/__pycache__/*
copilot-instructions.md
*.bat

# 环境变量与本地数据，禁止入库
.env
.env.docker
/data/
/backups/
# SSL 证书/私钥禁止入库（启用 HTTPS 时放入 nginx/certs/）
/nginx/certs/
/static/banner/*
/static/uploads/*


# 保留目录占位
.codebuddy/
!/static/banner/.gitkeep
!/static/uploads/.gitkeep

