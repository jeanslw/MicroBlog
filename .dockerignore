# 版本控制
.git
.gitignore
.gitattributes

# IDE / 编辑器
.idea
.vscode

# Python 缓存
__pycache__
*.pyc
*.pyo
*.pyd
.venv
venv

# 环境变量（绝不打入镜像）
.env
.env.*
!.env.example

