# ====================================================
# 博客系统环境变量示例
# 使用方法：复制本文件为 .env，填入实际值
#   cp .env.example .env
# .env 已在 .gitignore 中忽略，不会入库
#
# 说明：以下列出全部可选配置项。带 # 注释的为「可选/默认项」，
# 取消注释并填入值即可开启；留空或保持注释则使用内置默认值。
# ====================================================

# ── 必填（生产环境） ──────────────────────────────────────
# 设为 production 后，BLOG_SECRET_KEY 必须显式提供
BLOG_ENV=production

# Session/CSRF 密钥，务必使用随机长字符串
# 生成命令：python -c "import secrets;print(secrets.token_hex(32))"
BLOG_SECRET_KEY=

# ── 调试 ─────────────────────────────────────────────────
# 生产环境保持 False，避免 Werkzeug 调试器暴露导致 RCE
BLOG_DEBUG=False

# ── 数据库 ───────────────────────────────────────────────
# 数据库类型：sqlite 或 mysql
BLOG_DB_TYPE=sqlite

# MySQL 配置（BLOG_DB_TYPE=mysql 时生效）
BLOG_MYSQL_HOST=localhost
BLOG_MYSQL_USER=root
BLOG_MYSQL_PWD=
BLOG_MYSQL_DB=flask_blog

# SQLite 配置（BLOG_DB_TYPE=sqlite 时生效）
BLOG_SQLITE_PATH=data/blog.db

# ── 业务参数 ─────────────────────────────────────────────
BLOG_PAGE_SIZE=6
# 静态文件缓存秒数（生产建议 43200）
BLOG_STATIC_MAX_AGE=0

# ── 反向代理（部署在 nginx 等代理后时开启） ──────────────
# 信任的反向代理层数，用于正确获取真实客户端 IP / 协议 / Host
#（对应 Flask ProxyFix 的 x_for / x_proto / x_host）
#BLOG_PROXY_XFOR=1
#BLOG_PROXY_XPROTO=1
#BLOG_PROXY_XHOST=1

# ── 邮件（找回密码 / 通知，可选） ────────────────────────
# 不配置则「忘记密码」功能不可用；后台「邮件设置」保存后优先于此处生效
#BLOG_MAIL_HOST=smtp.example.com
#BLOG_MAIL_PORT=587
#BLOG_MAIL_USER=your_account@example.com
#BLOG_MAIL_PASSWORD=
#BLOG_MAIL_FROM=your_account@example.com
# 使用 SSL（通常 465 端口）
#BLOG_MAIL_USE_SSL=False
# 使用 STARTTLS（通常 587 端口，默认开启）
#BLOG_MAIL_USE_TLS=True
# 密码找回令牌有效期（秒，默认 1800 = 30 分钟）
#BLOG_RESET_TOKEN_MAX_AGE=1800

# ── 初始管理员（仅 SQLite 首次建表写入一次） ─────────────
BLOG_INIT_ADMIN_USER=admin
# 首次启动需要设置；建表后修改密码请走「后台 → 改密码」
BLOG_INIT_ADMIN_PWD=
